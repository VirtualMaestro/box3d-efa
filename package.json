{
  "name": "box3d-efa",
  "version": "0.4.4",
  "description": "Box3D, Erin Catto's 3D physics engine, compiled to WebAssembly for the EFA project. Built for EFA's needs: no promise of general use or a stable API.",
  "type": "module",
  "main": "dist/entry.mjs",
  "exports": {
    ".": "./dist/entry.mjs",
    "./standard": "./dist/box3d.mjs",
    "./scalar": "./dist/box3d.scalar.mjs",
    "./deluxe": "./dist/box3d.deluxe.mjs",
    "./package.json": "./package.json",
    "./iso": "./dist/iso.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE.box3d.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch-deps": "bash scripts/fetch-deps.sh",
    "build": "bash scripts/build.sh",
    "build:debug": "TARGET_TYPE=Debug bash scripts/build.sh",
    "test": "node --test \"test/*.test.mjs\"",
    "prepublishOnly": "node --test \"test/*.test.mjs\"",
    "lint": "eslint .",
    "lint:native": "clang-format --dry-run --Werror csrc/*.cpp"
  },
  "keywords": [
    "physics",
    "3d",
    "box3d",
    "box2d",
    "wasm",
    "webassembly",
    "simd",
    "threads",
    "rigid-body",
    "game",
    "simulation"
  ],
  "author": "VirtualMaestro",
  "contributors": [
    "Luis Montes"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VirtualMaestro/box3d-efa.git"
  },
  "bugs": {
    "url": "https://github.com/VirtualMaestro/box3d-efa/issues"
  },
  "homepage": "https://github.com/VirtualMaestro/box3d-efa#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "clang-format": "^1.8.0",
    "eslint": "^9.39.4",
    "typescript": "^5.7.0"
  }
}
